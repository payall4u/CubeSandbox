+
+package server
+
+import (
+	"context"
+	"errors"
+	"reflect"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	sb "github.com/containerd/containerd/v2/core/sandbox"
+)
+
+func TestCreateSandboxWhileSettingUpNetworkOverlapsAndWaitsForBoth(t *testing.T) {
+	setupEntered := make(chan struct{})
+	createEntered := make(chan struct{})
+	var shutdowns atomic.Int32
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+
+	network, createErr, shutdownErr := createSandboxWhileSettingUpNetwork(
+		ctx,
+		func(ctx context.Context) error {
+			close(setupEntered)
+			select {
+			case <-createEntered:
+				return nil
+			case <-ctx.Done():
+				return ctx.Err()
+			}
+		},
+		func() error {
+			select {
+			case <-setupEntered:
+			case <-ctx.Done():
+				return ctx.Err()
+			}
+			close(createEntered)
+			return nil
+		},
+		func() error {
+			shutdowns.Add(1)
+			return nil
+		},
+	)
+	if network.err != nil || createErr != nil || shutdownErr != nil {
+		t.Fatalf("network=%v create=%v shutdown=%v", network.err, createErr, shutdownErr)
+	}
+	if shutdowns.Load() != 0 {
+		t.Fatalf("shutdowns=%d", shutdowns.Load())
+	}
+}
+
+func TestCreateSandboxWhileSettingUpNetworkCancelsNetworkAfterCreateFailure(t *testing.T) {
+	createFailure := errors.New("create failed")
+	setupEntered := make(chan struct{})
+	var shutdowns atomic.Int32
+	network, createErr, shutdownErr := createSandboxWhileSettingUpNetwork(
+		context.Background(),
+		func(ctx context.Context) error {
+			close(setupEntered)
+			<-ctx.Done()
+			return ctx.Err()
+		},
+		func() error {
+			<-setupEntered
+			return createFailure
+		},
+		func() error {
+			shutdowns.Add(1)
+			return nil
+		},
+	)
+	if !errors.Is(createErr, createFailure) || !errors.Is(network.err, context.Canceled) || shutdownErr != nil {
+		t.Fatalf("network=%v create=%v shutdown=%v", network.err, createErr, shutdownErr)
+	}
+	if !network.canceledByCreateFailure {
+		t.Fatal("network cancellation was not attributed to create failure")
+	}
+	if shutdowns.Load() != 0 {
+		t.Fatalf("shutdowns=%d, want 0", shutdowns.Load())
+	}
+}
+
+func TestSandboxCreateNetworkErrorKeepsCreateFailureAsPrimaryAfterInducedCancellation(t *testing.T) {
+	createFailure := errors.New("create failed")
+	err := sandboxCreateNetworkError("sandbox-1", sandboxNetworkSetupResult{
+		err:                     context.Canceled,
+		canceledByCreateFailure: true,
+	}, createFailure)
+	if !errors.Is(err, createFailure) {
+		t.Fatalf("error does not retain create failure: %v", err)
+	}
+	if errors.Is(err, context.Canceled) {
+		t.Fatalf("induced cancellation leaked into primary error chain: %v", err)
+	}
+}
+
+func TestSandboxCreateNetworkErrorRetainsIndependentDualFailures(t *testing.T) {
+	createFailure := errors.New("create failed")
+	networkFailure := errors.New("network failed")
+	err := sandboxCreateNetworkError("sandbox-1", sandboxNetworkSetupResult{
+		err:                     networkFailure,
+		canceledByCreateFailure: true,
+	}, createFailure)
+	if !errors.Is(err, createFailure) || !errors.Is(err, networkFailure) {
+		t.Fatalf("error does not retain both failures: %v", err)
+	}
+}
+
+func TestCreateSandboxWhileSettingUpNetworkShutsDownCreatedSandboxOnNetworkFailure(t *testing.T) {
+	networkFailure := errors.New("network failed")
+	createEntered := make(chan struct{})
+	var shutdowns atomic.Int32
+	network, createErr, shutdownErr := createSandboxWhileSettingUpNetwork(
+		context.Background(),
+		func(context.Context) error {
+			<-createEntered
+			return networkFailure
+		},
+		func() error {
+			close(createEntered)
+			return nil
+		},
+		func() error {
+			shutdowns.Add(1)
+			return nil
+		},
+	)
+	if !errors.Is(network.err, networkFailure) || createErr != nil || shutdownErr != nil {
+		t.Fatalf("network=%v create=%v shutdown=%v", network.err, createErr, shutdownErr)
+	}
+	if shutdowns.Load() != 1 {
+		t.Fatalf("shutdowns=%d, want 1", shutdowns.Load())
+	}
+}
+
+func TestCreateSandboxWhileSettingUpNetworkReturnsShutdownFailure(t *testing.T) {
+	networkFailure := errors.New("network failed")
+	shutdownFailure := errors.New("shutdown failed")
+	network, createErr, shutdownErr := createSandboxWhileSettingUpNetwork(
+		context.Background(),
+		func(context.Context) error { return networkFailure },
+		func() error { return nil },
+		func() error { return shutdownFailure },
+	)
+	if !errors.Is(network.err, networkFailure) || createErr != nil || !errors.Is(shutdownErr, shutdownFailure) {
+		t.Fatalf("network=%v create=%v shutdown=%v", network.err, createErr, shutdownErr)
+	}
+}
+
+func TestStartCreatedSandboxRollsBackEveryPreStartFailure(t *testing.T) {
+	failure := errors.New("injected pre-start failure")
+	for _, test := range []struct {
+		name      string
+		failAt    string
+		wantCalls []string
+	}{
+		{name: "persist network", failAt: "persist", wantCalls: []string{"persist", "shutdown"}},
+		{name: "ensure pause", failAt: "pause", wantCalls: []string{"persist", "pause", "shutdown"}},
+		{name: "start sandbox", failAt: "start", wantCalls: []string{"persist", "pause", "start", "shutdown"}},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			var calls []string
+			step := func(name string) error {
+				calls = append(calls, name)
+				if test.failAt == name {
+					return failure
+				}
+				return nil
+			}
+			_, cleanupErr, err := startCreatedSandboxWithRollback(
+				func() error { return step("persist") },
+				func() error { return step("pause") },
+				func() (sb.ControllerInstance, error) {
+					return sb.ControllerInstance{}, step("start")
+				},
+				func() error { return step("shutdown") },
+			)
+			if !errors.Is(err, failure) || cleanupErr != nil {
+				t.Fatalf("error=%v cleanup=%v", err, cleanupErr)
+			}
+			if !reflect.DeepEqual(calls, test.wantCalls) {
+				t.Fatalf("calls=%v, want %v", calls, test.wantCalls)
+			}
+		})
+	}
+}
+
+func TestStartCreatedSandboxReportsRollbackFailure(t *testing.T) {
+	pauseFailure := errors.New("pause failed")
+	shutdownFailure := errors.New("shutdown failed")
+	_, cleanupErr, err := startCreatedSandboxWithRollback(
+		nil,
+		func() error { return pauseFailure },
+		func() (sb.ControllerInstance, error) {
+			t.Fatal("start called after pause failure")
+			return sb.ControllerInstance{}, nil
+		},
+		func() error { return shutdownFailure },
+	)
+	if !errors.Is(err, pauseFailure) || !errors.Is(cleanupErr, shutdownFailure) {
+		t.Fatalf("error=%v cleanup=%v", err, cleanupErr)
+	}
+}
+
+func TestStartCreatedSandboxTransfersOwnershipAfterStart(t *testing.T) {
+	var shutdowns atomic.Int32
+	want := sb.ControllerInstance{SandboxID: "sandbox-1"}
+	got, cleanupErr, err := startCreatedSandboxWithRollback(
+		nil,
+		func() error { return nil },
+		func() (sb.ControllerInstance, error) { return want, nil },
+		func() error {
+			shutdowns.Add(1)
+			return nil
+		},
+	)
+	if err != nil || cleanupErr != nil || got.SandboxID != want.SandboxID {
+		t.Fatalf("controller=%+v error=%v cleanup=%v", got, err, cleanupErr)
+	}
+	if shutdowns.Load() != 0 {
+		t.Fatalf("shutdowns=%d", shutdowns.Load())
+	}
+}
