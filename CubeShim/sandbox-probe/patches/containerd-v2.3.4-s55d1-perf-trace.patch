+
+// Package cubeperf provides an opt-in monotonic timeline for the CubeSandbox
+// PoC. It is inert unless CUBE_PERF_TRACE=1 and the request is explicitly
+// associated with the cube runtime handler.
+package cubeperf
+
+import (
+	"context"
+	"os"
+
+	"github.com/containerd/log"
+)
+
+type operation struct {
+	podUID    string
+	sandboxID string
+}
+
+type operationKey struct{}
+
+var enabled = os.Getenv("CUBE_PERF_TRACE") == "1"
+
+// WithPod starts a trace context for one Cube RunPodSandbox request.
+func WithPod(ctx context.Context, podUID string) context.Context {
+	if !enabled || podUID == "" {
+		return ctx
+	}
+	return context.WithValue(ctx, operationKey{}, operation{podUID: podUID})
+}
+
+// WithSandbox binds the containerd-generated sandbox ID to the request trace.
+func WithSandbox(ctx context.Context, sandboxID string) context.Context {
+	if !enabled || sandboxID == "" {
+		return ctx
+	}
+	op, ok := ctx.Value(operationKey{}).(operation)
+	if !ok {
+		return ctx
+	}
+	op.sandboxID = sandboxID
+	return context.WithValue(ctx, operationKey{}, op)
+}
+
+// Enabled reports whether a request has opted into the Cube performance trace.
+func Enabled(ctx context.Context) bool {
+	if !enabled {
+		return false
+	}
+	_, ok := ctx.Value(operationKey{}).(operation)
+	return ok
+}
+
+// Now returns CLOCK_MONOTONIC microseconds, or zero on unsupported platforms.
+func Now() int64 {
+	if !enabled {
+		return 0
+	}
+	return monotonicMicros()
+}
+
+// Point emits a request-correlated point in the host CLOCK_MONOTONIC domain.
+func Point(ctx context.Context, phase string) {
+	if !Enabled(ctx) {
+		return
+	}
+	now := monotonicMicros()
+	if now == 0 {
+		return
+	}
+	op := ctx.Value(operationKey{}).(operation)
+	log.G(ctx).Infof(
+		"cube_perf component=containerd operation=run-pod-sandbox phase=%s sandbox_id=%s pod_uid=%s ts_mono_us=%d",
+		phase, op.sandboxID, op.podUID, now,
+	)
+}
+
+// End emits the endpoint and duration of a stage begun with Now.
+func End(ctx context.Context, phase string, started int64) {
+	if !Enabled(ctx) || started == 0 {
+		return
+	}
+	now := monotonicMicros()
+	if now == 0 {
+		return
+	}
+	op := ctx.Value(operationKey{}).(operation)
+	log.G(ctx).Infof(
+		"cube_perf component=containerd operation=run-pod-sandbox phase=%s sandbox_id=%s pod_uid=%s ts_mono_us=%d duration_us=%d",
+		phase, op.sandboxID, op.podUID, now, now-started,
+	)
+}
