+package config
+
+import "testing"
+
+func TestValidateSandboxCreateBeforeNetwork(t *testing.T) {
+	for _, test := range []struct {
+		name      string
+		runtime   Runtime
+		wantError bool
+	}{
+		{name: "disabled podsandbox", runtime: Runtime{Sandboxer: string(ModePodSandbox)}},
+		{name: "disabled shim", runtime: Runtime{Sandboxer: string(ModeShim)}},
+		{name: "enabled shim", runtime: Runtime{Sandboxer: string(ModeShim), SandboxCreateBeforeNetwork: true}},
+		{name: "enabled podsandbox", runtime: Runtime{Sandboxer: string(ModePodSandbox), SandboxCreateBeforeNetwork: true}, wantError: true},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			err := validateSandboxCreateBeforeNetwork("test", test.runtime)
+			if (err != nil) != test.wantError {
+				t.Fatalf("error=%v wantError=%t", err, test.wantError)
+			}
+		})
+	}
