+type sandboxNetworkSetupResult struct {
+	err                     error
+	canceledByCreateFailure bool
+}
+
+func sandboxCreateNetworkError(id string, network sandboxNetworkSetupResult, createErr error) error {
+	if createErr != nil {
+		createFailure := fmt.Errorf("failed to create sandbox %q: %w", id, createErr)
+		if network.err == nil || (network.canceledByCreateFailure && errors.Is(network.err, context.Canceled)) {
+			return createFailure
+		}
+		return errors.Join(
+			createFailure,
+			fmt.Errorf("failed to setup network for sandbox %q: %w", id, network.err),
+		)
+	}
+	if network.err != nil {
+		return fmt.Errorf("failed to setup network for sandbox %q: %w", id, network.err)
+	}
+	return nil
+}
+
+func createSandboxWhileSettingUpNetwork(
+	ctx context.Context,
+	setupNetwork func(context.Context) error,
+	createSandbox func() error,
+	shutdownSandbox func() error,
+) (sandboxNetworkSetupResult, error, error) {
+	networkCtx, cancelNetwork := context.WithCancel(ctx)
+	defer cancelNetwork()
+	networkStarted := make(chan struct{})
+	networkDone := make(chan sandboxNetworkSetupResult, 1)
+	go func() {
+		started := cubeperf.Now()
+		close(networkStarted)
+		err := setupNetwork(networkCtx)
+		cubeperf.End(ctx, "cni-setup", started)
+		networkDone <- sandboxNetworkSetupResult{err: err}
+	}()
+	<-networkStarted
+
+	createErr := createSandbox()
+	canceledByCreateFailure := createErr != nil
+	if canceledByCreateFailure {
+		cancelNetwork()
+	}
+	completed := <-networkDone
+	completed.canceledByCreateFailure = canceledByCreateFailure
+	if completed.err != nil && createErr == nil {
+		return completed, nil, shutdownSandbox()
+	}
+	return completed, createErr, nil
+}
+
+func startCreatedSandboxWithRollback(
+	persistNetwork func() error,
+	ensurePause func() error,
+	startSandbox func() (sb.ControllerInstance, error),
+	shutdownSandbox func() error,
+) (ctrl sb.ControllerInstance, cleanupErr, retErr error) {
+	defer func() {
+		if retErr == nil {
+			return
+		}
+		if err := shutdownSandbox(); err != nil && !errdefs.IsNotFound(err) {
+			cleanupErr = fmt.Errorf("shutdown sandbox after pre-start failure: %w", err)
+		}
+	}()
+
+	if persistNetwork != nil {
+		if err := persistNetwork(); err != nil {
+			return sb.ControllerInstance{}, nil, err
+		}
+	}
+	if err := ensurePause(); err != nil {
+		return sb.ControllerInstance{}, nil, err
+	}
+	ctrl, retErr = startSandbox()
+	return
+}
